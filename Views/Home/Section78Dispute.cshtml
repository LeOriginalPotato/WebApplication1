@model Section78DisputeViewModel
@{
    ViewData["Title"] = "Section 78 Dispute";
}

<section style="max-width:920px;margin:1.2rem auto;background:rgba(20,27,39,.95);border:1px solid rgba(255,255,255,.12);border-radius:16px;padding:1.2rem;box-shadow:0 14px 30px rgba(0,0,0,.32);">
    <h1 style="color:#fff;font-size:1.35rem;font-weight:700;">Section 78 Dispute Submission</h1>
    <p style="color:#a0aec0;">Upload the documents and details normally needed to challenge a municipal property categorization or valuation issue.</p>

    @if (TempData["Section78Success"] is string success)
    {
        <div style="margin-bottom:1rem;border-radius:10px;padding:.75rem;background:rgba(0,191,110,.16);border:1px solid rgba(0,191,110,.45);color:#a8f2ca;">@success</div>
    }

    <div asp-validation-summary="ModelOnly" style="margin-bottom:1rem;border-radius:10px;padding:.75rem;background:rgba(255,141,161,.12);border:1px solid rgba(255,141,161,.45);color:#ffd0da;"></div>

    <form asp-action="Section78Dispute" asp-controller="Home" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="PropertyAddress" class="form-label text-white"></label>
                <input asp-for="PropertyAddress" class="form-control" />
                <span asp-validation-for="PropertyAddress" class="text-warning"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="MunicipalAccountNumber" class="form-label text-white"></label>
                <input asp-for="MunicipalAccountNumber" class="form-control" />
                <span asp-validation-for="MunicipalAccountNumber" class="text-warning"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="ErfNumber" class="form-label text-white"></label>
                <input asp-for="ErfNumber" class="form-control" />
                <span asp-validation-for="ErfNumber" class="text-warning"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="PropertyCategoryDispute" class="form-label text-white"></label>
                <input asp-for="PropertyCategoryDispute" class="form-control" />
                <span asp-validation-for="PropertyCategoryDispute" class="text-warning"></span>
            </div>
            <div class="col-12">
                <label asp-for="OwnerStatement" class="form-label text-white"></label>
                <textarea asp-for="OwnerStatement" class="form-control" rows="5"></textarea>
                <span asp-validation-for="OwnerStatement" class="text-warning"></span>
            </div>
            <div class="col-12">
                <div style="border:1px solid rgba(255,255,255,.12);border-radius:12px;padding:.85rem;background:rgba(255,255,255,.03);">
                    <div class="form-check mb-2">
                        <input asp-for="NoFormalNoticeReceived" class="form-check-input" />
                        <label asp-for="NoFormalNoticeReceived" class="form-check-label text-light"></label>
                    </div>
                    <span asp-validation-for="NoFormalNoticeReceived" class="text-warning d-block mb-2"></span>
                    <div class="form-check mb-2">
                        <input asp-for="NoSection78DocumentsReceived" class="form-check-input" />
                        <label asp-for="NoSection78DocumentsReceived" class="form-check-label text-light"></label>
                    </div>
                    <span asp-validation-for="NoSection78DocumentsReceived" class="text-warning d-block"></span>
                </div>
            </div>
            <div class="col-md-4">
                <label asp-for="SupportingDocument" class="form-label text-white"></label>
                <input asp-for="SupportingDocument" class="form-control" type="file" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" />
                <span asp-validation-for="SupportingDocument" class="text-warning"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="IdentityDocument" class="form-label text-white"></label>
                <input asp-for="IdentityDocument" class="form-control" type="file" accept=".pdf,.jpg,.jpeg,.png" />
                <span asp-validation-for="IdentityDocument" class="text-warning"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="MunicipalAccountProof" class="form-label text-white"></label>
                <input asp-for="MunicipalAccountProof" class="form-control" type="file" accept=".pdf,.jpg,.jpeg,.png" />
                <span asp-validation-for="MunicipalAccountProof" class="text-warning"></span>
            </div>
            <div class="col-12">
                <label asp-for="AdditionalNotes" class="form-label text-white"></label>
                <textarea asp-for="AdditionalNotes" class="form-control" rows="3"></textarea>
                <span asp-validation-for="AdditionalNotes" class="text-warning"></span>
            </div>
            <div class="col-12 d-grid">
                <button type="submit" style="border:1px solid #ffcc00;background:#ffcc00;color:#1a1f2c;font-weight:800;border-radius:999px;padding:.6rem 1rem;">Submit Section 78 Dispute</button>
            </div>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
