@{
    ViewData["Title"] = "Resident Dashboard";
    var currentRole = User.FindFirst("UserRole")?.Value ?? string.Empty;
    var isResident = string.Equals(currentRole, "Resident", StringComparison.OrdinalIgnoreCase);
    var isProfileComplete = string.Equals(User.FindFirst("IsProfileComplete")?.Value, "True", StringComparison.OrdinalIgnoreCase);
    var identityName = User.Identity?.Name ?? string.Empty;
    var firstNameParts = identityName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var firstName = firstNameParts.Length > 0 ? firstNameParts[0] : "Leader";
}

<style>
    .resident-dashboard {
        color: #a0aec0;
    }

    .hero-block {
        background: linear-gradient(140deg, rgba(0, 104, 55, 0.25), rgba(16, 22, 34, 0.9));
        border: 1px solid rgba(255, 204, 0, 0.3);
        border-radius: 18px;
        padding: 1.4rem;
        box-shadow: 0 14px 30px rgba(0, 0, 0, 0.28);
        margin-bottom: 1.4rem;
    }

    .hero-title {
        color: #ffffff;
        font-size: clamp(1.3rem, 2.8vw, 2rem);
        font-weight: 700;
        margin-bottom: 1rem;
    }

    .sector-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
        gap: 0.8rem;
    }

    .sector-item {
        background: rgba(20, 28, 42, 0.86);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        padding: 0.9rem;
    }

    .sector-label {
        display: block;
        color: #ffcc00;
        font-weight: 700;
        margin-bottom: 0.2rem;
        font-size: 0.86rem;
        letter-spacing: 0.03em;
        text-transform: uppercase;
    }

    .action-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .action-card {
        background: rgba(22, 27, 39, 0.95);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 16px;
        padding: 1.2rem;
        transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
    }

    .action-card:hover {
        transform: translateY(-4px) scale(1.01);
        box-shadow: 0 16px 36px rgba(0, 0, 0, 0.35);
        border-color: rgba(255, 204, 0, 0.35);
    }

    .action-title {
        color: #ffffff;
        font-size: 1.1rem;
        font-weight: 700;
        margin-bottom: 0.55rem;
    }

    .action-card p {
        margin-bottom: 0.9rem;
    }

    .expandable-pane {
        display: none;
        margin-top: 1rem;
        border-top: 1px solid rgba(255, 255, 255, 0.12);
        padding-top: 1rem;
    }

    .expandable-pane.open {
        display: block;
        animation: fadeIn .24s ease;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(-4px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .form-label {
        color: #ffffff;
        font-weight: 600;
    }

    .form-control,
    .form-select {
        background-color: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.16);
        color: #ffffff;
    }

    .form-select option {
        background: #1f2636;
        color: #ffffff;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: #ffcc00;
        box-shadow: 0 0 0 0.22rem rgba(255, 204, 0, 0.2);
        background-color: rgba(255, 255, 255, 0.08);
        color: #ffffff;
    }

    .proof-dropzone {
        border: 1.5px dashed rgba(255, 204, 0, 0.55);
        border-radius: 14px;
        padding: 1rem;
        text-align: center;
        background: rgba(255, 204, 0, 0.06);
        color: #e8eef9;
        transition: background-color .2s ease, border-color .2s ease;
    }

    .proof-dropzone:hover {
        background: rgba(255, 204, 0, 0.12);
        border-color: #ffcc00;
    }

    .proof-icon {
        font-size: 1.7rem;
        display: block;
        margin-bottom: 0.3rem;
    }

    .check-wrap {
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 12px;
        padding: 0.85rem;
        background: rgba(255, 255, 255, 0.03);
        margin-bottom: 0.8rem;
    }

    .form-check-label {
        color: #d6deeb;
    }

    .btn-gold {
        background: #ffcc00;
        color: #1a1f2c;
        font-weight: 800;
        border: 1px solid #ffcc00;
        border-radius: 999px;
        padding: 0.6rem 1rem;
        transition: transform .2s ease, box-shadow .2s ease, background-color .2s ease;
    }

    .btn-gold:hover,
    .btn-gold:focus {
        background: #ffe066;
        color: #1a1f2c;
        transform: translateY(-1px);
        box-shadow: 0 0 0 0.22rem rgba(255, 204, 0, 0.24);
    }

    .btn-gold:active {
        transform: scale(0.98);
    }

    .queue-card {
        background: rgba(21, 27, 39, 0.9);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 16px;
        padding: 1.2rem;
    }

    .queue-title {
        color: #ffffff;
        font-size: 1.15rem;
        font-weight: 700;
        margin-bottom: 0.9rem;
    }

    .ticket-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 0.75rem;
    }

    .ticket-item {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.8rem;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
        padding: 0.85rem 0.9rem;
        background: rgba(255, 255, 255, 0.02);
    }

    .ticket-ref {
        color: #ffffff;
        font-weight: 700;
    }

    .ticket-date {
        font-size: 0.88rem;
    }

    .status-pill {
        border-radius: 999px;
        padding: 0.35rem 0.75rem;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        border: 1px solid transparent;
        white-space: nowrap;
    }

    .status-logged {
        color: #ffd86b;
        border-color: rgba(255, 184, 0, 0.5);
        box-shadow: 0 0 12px rgba(255, 184, 0, 0.35);
        background: rgba(255, 184, 0, 0.12);
    }

    .status-escalated {
        color: #8fd9ff;
        border-color: rgba(68, 170, 255, 0.65);
        box-shadow: 0 0 14px rgba(68, 170, 255, 0.4);
        background: rgba(68, 170, 255, 0.13);
    }

    .status-resolved {
        color: #8bf0bc;
        border-color: rgba(0, 191, 110, 0.55);
        box-shadow: 0 0 14px rgba(0, 191, 110, 0.38);
        background: rgba(0, 191, 110, 0.14);
    }
</style>

<div class="resident-dashboard">
    <section class="hero-block">
        <h1 class="hero-title">Good Day, @firstName. Let's fix Randfontein together.</h1>
        <div class="sector-grid">
            <article class="sector-item">
                <span class="sector-label">Localized Sector</span>
                <strong>Mohlakeng / Rural Holdings Desk</strong>
            </article>
            <article class="sector-item">
                <span class="sector-label">Operations Window</span>
                <strong>Weekend Complaint Consolidation Active</strong>
            </article>
        </div>
    </section>

    <section class="action-grid">
        <article class="action-card">
            <h2 class="action-title">🚨 Report Infrastructure Failure</h2>
            <p>Log urgent municipal infrastructure issues with geolocation and proof attachment.</p>

            @if (isResident && !isProfileComplete)
            {
                <div style="border:1px solid rgba(255,141,161,.5);background:rgba(255,141,161,.1);color:#ffd0da;border-radius:10px;padding:.75rem;">
                    Complete your resident profile before submitting complaints.
                    <a asp-controller="Account" asp-action="Register" style="font-weight:700;">Update Profile</a>
                </div>
            }
            else
            {
                <button id="toggleReportForm" type="button" class="btn btn-gold">Open Report Form</button>

                <div id="reportFormPane" class="expandable-pane">
                    <form id="faultReportForm" method="post">
                        <div class="mb-3">
                            <label class="form-label" for="category">Category</label>
                            <select id="category" name="CategoryID" class="form-select" required>
                                <option value="1">Electrical &amp; Grid</option>
                                <option value="2">Roads &amp; Transport</option>
                                <option value="3">Water &amp; Sanitation</option>
                                <option value="4">Environmental &amp; Landfill</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="description">Description</label>
                            <textarea id="description" name="Description" class="form-control" rows="4" required></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="physicalAddress">Physical Street Address</label>
                            <input id="physicalAddress" name="PhysicalAddress" class="form-control" required />
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label" for="latitude">Latitude</label>
                                <input id="latitude" name="Latitude" type="number" step="0.000001" class="form-control" required />
                            </div>
                            <div class="col-6">
                                <label class="form-label" for="longitude">Longitude</label>
                                <input id="longitude" name="Longitude" type="number" step="0.000001" class="form-control" required />
                            </div>
                        </div>
                        <div class="mb-3 proof-dropzone">
                            <span class="proof-icon">📷</span>
                            <strong>Drag &amp; Drop Photo Proof</strong>
                            <div>Supported formats: JPG, PNG, HEIC</div>
                        </div>
                        <button id="faultSubmitButton" type="submit" class="btn btn-gold">Submit Fault Report</button>
                        <div id="faultResult" class="mt-3"></div>
                    </form>
                </div>
            }
        </article>

        <article class="action-card">
            <h2 class="action-title">Mass Rates Objection Portal</h2>
            <p>Submit a structural Section 78 dispute for incorrect municipal categorization and valuation impacts.</p>
            <div class="check-wrap">
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="confirmNoticeA" required>
                    <label class="form-check-label" for="confirmNoticeA">I confirm that I did not receive a formal municipal reclassification notice.</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="confirmNoticeB" required>
                    <label class="form-check-label" for="confirmNoticeB">I confirm that no lawful Section 78 prior engagement documents were delivered to my address.</label>
                </div>
            </div>
            <a class="btn btn-gold" asp-controller="Home" asp-action="Section78Dispute">File Section 78 Dispute</a>
        </article>
    </section>

    <section class="queue-card">
        <h2 class="queue-title">My Live Action Queue</h2>
        <ul id="myComplaintsList" class="ticket-list">
            <li class="ticket-item">
                <div class="ticket-date">Loading your complaints...</div>
            </li>
        </ul>
    </section>
</div>

<script>
    (function () {
        const toggleButton = document.getElementById("toggleReportForm");
        const panel = document.getElementById("reportFormPane");
        const form = document.getElementById("faultReportForm");
        const submitButton = document.getElementById("faultSubmitButton");
        const faultResult = document.getElementById("faultResult");
        const complaintsList = document.getElementById("myComplaintsList");

        const getStatusCss = (status) => {
            if (!status) return "status-logged";
            const value = status.toLowerCase();
            if (value.includes("resolved")) return "status-resolved";
            if (value.includes("escalated") || value.includes("inspection") || value.includes("dispatched")) return "status-escalated";
            return "status-logged";
        };

        const loadMyComplaints = async () => {
            if (!complaintsList) {
                return;
            }

            try {
                const response = await fetch("/api/infrastructure/my-complaints");
                if (!response.ok) {
                    complaintsList.innerHTML = "<li class='ticket-item'><div class='ticket-date'>Unable to load complaints right now.</div></li>";
                    return;
                }

                const complaints = await response.json();
                complaintsList.innerHTML = "";

                if (!complaints.length) {
                    complaintsList.innerHTML = "<li class='ticket-item'><div class='ticket-date'>No complaints logged yet.</div></li>";
                    return;
                }

                complaints.forEach((item) => {
                    const statusClass = getStatusCss(item.status);
                    const loggedDate = new Date(item.dateLogged).toLocaleString();
                    const updatedDate = new Date(item.lastUpdatedAt).toLocaleString();
                    const latestUpdate = item.latestUpdate || item.status;

                    const entry = document.createElement("li");
                    entry.className = "ticket-item";
                    entry.innerHTML = `
                        <div>
                            <div class="ticket-ref">${item.ticketReference}</div>
                            <div class="ticket-date">Logged on ${loggedDate}</div>
                            <div class="ticket-date">Latest update (${updatedDate}): ${latestUpdate}</div>
                        </div>
                        <span class="status-pill ${statusClass}">${item.status}</span>`;
                    complaintsList.appendChild(entry);
                });
            } catch {
                complaintsList.innerHTML = "<li class='ticket-item'><div class='ticket-date'>Network error while loading complaints.</div></li>";
            }
        };

        loadMyComplaints();

        if (!toggleButton || !panel || !form || !submitButton || !faultResult) {
            return;
        }

        toggleButton.addEventListener("click", function () {
            panel.classList.toggle("open");
            toggleButton.textContent = panel.classList.contains("open") ? "Hide Report Form" : "Open Report Form";
        });

        form.addEventListener("submit", async function (event) {
            event.preventDefault();
            submitButton.disabled = true;
            submitButton.textContent = "Submitting...";
            faultResult.textContent = "";

            const payload = {
                categoryID: Number(document.getElementById("category").value),
                description: document.getElementById("description").value,
                physicalAddress: document.getElementById("physicalAddress").value,
                latitude: Number(document.getElementById("latitude").value),
                longitude: Number(document.getElementById("longitude").value)
            };

            try {
                const response = await fetch("/api/infrastructure/log-fault", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify(payload)
                });

                const result = await response.json();

                if (!response.ok) {
                    const message = result.message || "Unable to log fault.";
                    faultResult.innerHTML = `<span style='color:#ff8da1;'>${message}</span>`;
                    return;
                }

                faultResult.innerHTML = `<span style='color:#8bf0bc;font-weight:700;'>Fault logged successfully. Ticket: ${result.ticketReference || result.TicketReference}</span>`;
                form.reset();
                await loadMyComplaints();
            } catch {
                faultResult.innerHTML = "<span style='color:#ff8da1;'>Network error while submitting fault report.</span>";
            } finally {
                submitButton.disabled = false;
                submitButton.textContent = "Submit Fault Report";
            }
        });
    })();
</script>
