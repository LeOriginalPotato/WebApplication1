@{
    ViewData["Title"] = "Access Denied";
}

<section style="max-width:560px;margin:1.5rem auto;background:rgba(20,27,39,.95);border:1px solid rgba(255,255,255,.12);border-radius:14px;padding:1.2rem;box-shadow:0 12px 24px rgba(0,0,0,.3);text-align:center;">
    <h1 style="color:#ffffff;font-size:1.4rem;font-weight:700;">Access Denied</h1>
    <p style="color:#a0aec0;">Your account does not have permission to access this area.</p>
    <a asp-controller="Home" asp-action="Index" style="display:inline-block;margin-top:.4rem;border:1px solid #ffcc00;background:#ffcc00;color:#1a1f2c;font-weight:800;padding:.55rem .95rem;border-radius:999px;text-decoration:none;">Return to Dashboard</a>
</section>
