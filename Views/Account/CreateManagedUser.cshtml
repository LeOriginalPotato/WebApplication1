@model TheSolution.PAPortal.Web.Models.Account.CreateManagedUserViewModel
@{
    ViewData["Title"] = "Create Admin/PA Member";
}

<section style="max-width:700px;margin:1.2rem auto;background:rgba(20,27,39,.95);border:1px solid rgba(255,255,255,.12);border-radius:16px;padding:1.2rem;box-shadow:0 14px 30px rgba(0,0,0,.32);">
    <h1 style="color:#fff;font-size:1.35rem;font-weight:700;">Administrative User Provisioning</h1>
    <p style="color:#a0aec0;">Admins can create Admin and PA Member accounts. Only Server Admin users can create Server Admin accounts.</p>

    @if (TempData["ManagedUserCreated"] is string msg)
    {
        <div style="border:1px solid rgba(0,191,110,.5);background:rgba(0,191,110,.16);color:#a8f2ca;border-radius:10px;padding:.6rem .8rem;margin-bottom:.8rem;">@msg</div>
    }

    <form asp-action="CreateManagedUser" asp-controller="Account" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Username" class="form-label text-white"></label>
                <input asp-for="Username" class="form-control" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="UserRole" class="form-label text-white"></label>
                <select asp-for="UserRole" class="form-select">
                    <option value="PA Member">PA Member</option>
                    <option value="Admin">Admin</option>
                    @if (User.IsInRole("Server Admin"))
                    {
                        <option value="Server Admin">Server Admin</option>
                    }
                </select>
                <span asp-validation-for="UserRole" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="FirstName" class="form-label text-white"></label>
                <input asp-for="FirstName" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="LastName" class="form-label text-white"></label>
                <input asp-for="LastName" class="form-control" />
            </div>
            <div class="col-12">
                <label asp-for="PhysicalAddress" class="form-label text-white"></label>
                <input asp-for="PhysicalAddress" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="EmailAddress" class="form-label text-white"></label>
                <input asp-for="EmailAddress" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="CellNumber" class="form-label text-white"></label>
                <input asp-for="CellNumber" class="form-control" />
            </div>
            <div class="col-12">
                <label asp-for="Password" class="form-label text-white"></label>
                <input asp-for="Password" class="form-control" />
            </div>
            <div class="col-12 d-grid">
                <button type="submit" style="border:1px solid #ffcc00;background:#ffcc00;color:#1a1f2c;font-weight:800;border-radius:999px;padding:.6rem 1rem;">Create Managed User</button>
            </div>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
