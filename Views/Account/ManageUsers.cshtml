@model TheSolution.PAPortal.Web.Models.Account.ManageUsersViewModel
@{
    ViewData["Title"] = Model.Title;
}

<style>
    .staff-shell {
        display: grid;
        gap: 1rem;
    }

    .staff-banner {
        background: rgba(20, 27, 39, 0.95);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 16px;
        padding: 1.2rem;
        box-shadow: 0 14px 28px rgba(0, 0, 0, 0.3);
    }

    .staff-banner h1 {
        color: #fff;
        margin: 0 0 .35rem;
        font-size: 1.35rem;
        font-weight: 700;
    }

    .staff-banner p {
        color: #a0aec0;
        margin: 0;
    }

    .feedback {
        border-radius: 10px;
        padding: .7rem .85rem;
    }

    .feedback-success {
        background: rgba(0, 191, 110, 0.16);
        color: #a8f2ca;
        border: 1px solid rgba(0, 191, 110, 0.45);
    }

    .feedback-error {
        background: rgba(255, 141, 161, 0.12);
        color: #ffd0da;
        border: 1px solid rgba(255, 141, 161, 0.45);
    }

    .staff-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 1rem;
    }

    .staff-card {
        background: rgba(22, 27, 39, 0.95);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 16px;
        padding: 1rem;
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.22);
    }

    .staff-card h2 {
        color: #fff;
        font-size: 1.05rem;
        margin: 0;
    }

    .card-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .75rem;
        margin-bottom: .85rem;
        flex-wrap: wrap;
    }

    .role-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        padding: .35rem .7rem;
        font-size: .78rem;
        font-weight: 800;
        letter-spacing: .03em;
        text-transform: uppercase;
    }

    .role-server-admin {
        background: rgba(255, 204, 0, 0.16);
        border: 1px solid rgba(255, 204, 0, 0.42);
        color: #ffdd66;
    }

    .role-admin {
        background: rgba(68, 170, 255, 0.14);
        border: 1px solid rgba(68, 170, 255, 0.42);
        color: #8fd9ff;
    }

    .role-pa-member {
        background: rgba(0, 191, 110, 0.14);
        border: 1px solid rgba(0, 191, 110, 0.42);
        color: #a8f2ca;
    }

    .role-resident {
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.18);
        color: #d8e1ef;
    }

    .self-pill {
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        padding: .32rem .68rem;
        background: rgba(255, 141, 161, 0.12);
        border: 1px solid rgba(255, 141, 161, 0.35);
        color: #ffd0da;
        font-size: .78rem;
        font-weight: 700;
    }

    .form-label {
        color: #d8e1ef;
        font-weight: 600;
    }

    .form-control,
    .form-select {
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.16);
        color: #fff;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: #ffcc00;
        box-shadow: 0 0 0 0.2rem rgba(255, 204, 0, 0.18);
        background: rgba(255, 255, 255, 0.08);
        color: #fff;
    }

    .form-select option {
        background: #1f2636;
        color: #fff;
    }

    .btn-gold {
        border: 1px solid #ffcc00;
        background: #ffcc00;
        color: #1a1f2c;
        font-weight: 800;
        border-radius: 999px;
        padding: .6rem 1rem;
    }

    .btn-gold:hover {
        background: #ffe066;
        color: #1a1f2c;
    }
</style>

<section class="staff-shell">
    <div class="staff-banner">
        <h1>@Model.Title</h1>
        <p>@Model.Description</p>
    </div>

    @if (TempData["UserManagementSuccess"] is string success)
    {
        <div class="feedback feedback-success">@success</div>
    }

    @if (TempData["UserManagementError"] is string error)
    {
        <div class="feedback feedback-error">@error</div>
    }

    @if (!Model.Users.Any())
    {
        <div class="feedback feedback-error">@(Model.IsResidentTab ? "No resident accounts were found." : "No editable staff accounts were found.")</div>
    }
    else
    {
        <div class="staff-grid">
            @foreach (var user in Model.Users)
            {
                var roleClass = user.UserRole switch
                {
                    "Server Admin" => "role-pill role-server-admin",
                    "Admin" => "role-pill role-admin",
                    "PA Member" => "role-pill role-pa-member",
                    _ => "role-pill role-resident"
                };

                <form asp-action="UpdateManagedUser" asp-controller="Account" method="post" class="staff-card">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="UserID" value="@user.UserID" />
                    <input type="hidden" name="ReturnTab" value="@(Model.IsResidentTab ? "Residents" : "Users")" />

                    <div class="card-top">
                        <div>
                            <h2>@user.FirstName @user.LastName</h2>
                        </div>
                        <div class="d-flex gap-2 flex-wrap">
                            <span class="@roleClass">@user.UserRole</span>
                            @if (user.IsCurrentUser)
                            {
                                <span class="self-pill">Your Account</span>
                            }
                        </div>
                    </div>

                    <div class="row g-2">
                        <div class="col-12">
                            <label class="form-label" for="Username_@user.UserID">Username</label>
                            <input id="Username_@user.UserID" name="Username" class="form-control" value="@user.Username" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="FirstName_@user.UserID">First Name</label>
                            <input id="FirstName_@user.UserID" name="FirstName" class="form-control" value="@user.FirstName" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="LastName_@user.UserID">Surname</label>
                            <input id="LastName_@user.UserID" name="LastName" class="form-control" value="@user.LastName" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="PhysicalAddress_@user.UserID">Physical Address</label>
                            <input id="PhysicalAddress_@user.UserID" name="PhysicalAddress" class="form-control" value="@user.PhysicalAddress" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="EmailAddress_@user.UserID">Email Address</label>
                            <input id="EmailAddress_@user.UserID" name="EmailAddress" class="form-control" value="@user.EmailAddress" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="CellNumber_@user.UserID">Phone Number</label>
                            <input id="CellNumber_@user.UserID" name="CellNumber" class="form-control" value="@user.CellNumber" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="UserRole_@user.UserID">Role</label>
                            <select id="UserRole_@user.UserID" name="UserRole" class="form-select" required>
                                @if (Model.IsResidentTab)
                                {
                                    <option value="Resident" selected="true">Resident</option>
                                }
                                else
                                {
                                    @if (Model.CanEditServerAdmins)
                                    {
                                        <option value="Server Admin" selected="@(user.UserRole == "Server Admin")">Server Admin</option>
                                    }
                                    <option value="Admin" selected="@(user.UserRole == "Admin")">Admin</option>
                                    <option value="PA Member" selected="@(user.UserRole == "PA Member")">PA Member</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="NewPassword_@user.UserID">New Password</label>
                            <input id="NewPassword_@user.UserID" name="NewPassword" class="form-control" type="password" placeholder="Leave blank to keep current password" />
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="ConfirmNewPassword_@user.UserID">Confirm New Password</label>
                            <input id="ConfirmNewPassword_@user.UserID" name="ConfirmNewPassword" class="form-control" type="password" placeholder="Only required when changing password" />
                        </div>
                        <div class="col-12">
                            <button type="submit" class="btn btn-gold w-100">Save Changes</button>
                        </div>
                    </div>
                </form>
            }
        </div>
    }
</section>
