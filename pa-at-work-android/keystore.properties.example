# Copy this file to keystore.properties (gitignored) OR set the environment
# variables below. Never commit the keystore or the passwords.
#
#   PA_KEYSTORE_FILE
#   PA_KEYSTORE_PASSWORD
#   PA_KEY_ALIAS
#   PA_KEY_PASSWORD
#
# storeFile must be an absolute path, or a path relative to pa-at-work-android/.
# Keep the .jks file outside the repository.
# PKCS12 keystores (current keytool default) use one password. Set
# storePassword and keyPassword to that same value.

storeFile=/absolute/path/to/pa-atwork-upload.jks
storePassword=replace-me
keyAlias=pa-atwork
keyPassword=replace-me
