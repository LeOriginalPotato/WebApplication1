# Copy to .env for local development. Never commit .env.
# cPanel: set these in the Node.js application environment, not in the repo.

# mysql://USER:PASSWORD@HOST:3306/DATABASE
# Encode special characters in the password (for example @ becomes %40).
DATABASE_URL=mysql://pa_at_work:changeme@127.0.0.1:3306/pa_at_work

# Optional. cPanel often needs the MariaDB socket instead of TCP.
# DATABASE_SOCKET=/var/lib/mysql/mysql.sock

# Required. At least 32 characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Photos are stored here, outside the public web root.
UPLOAD_DIR=./storage/photos

# Set both to true on HTTPS cPanel, including a test subdomain.
# COOKIE_SECURE=true
# TRUST_PROXY=true

# Used only by `npm run create-admin`. Do not leave the password in the environment after the account exists.
# ADMIN_EMAIL=owner@example.com
# ADMIN_PASSWORD=
# ADMIN_NAME=Site Owner
